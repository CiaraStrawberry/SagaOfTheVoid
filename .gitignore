# Original build and bulk recovery output stay out of git
saga_original/
recovery/assetripper/
recovery/export/

# Game builds
builds/

# Recovered art (~2 GB) stays off GitHub (free LFS is 1 GB). Its .meta files ARE tracked, so
# `python tools/art_pack.py restore` puts it back with the same GUIDs. See tools/art_pack.py.
game/Assets/Imported/**/*.png
game/Assets/Imported/**/*.jpg
game/Assets/Imported/**/*.tga
game/Assets/Imported/**/*.psd
game/Assets/Imported/**/*.wav
game/Assets/Imported/**/*.ogg
game/Assets/Imported/**/*.mp3
game/Assets/Imported/**/*.ttf
game/Assets/Imported/**/*.otf
art_pack/

# Tool output (rebuildable)
tools/preview/frames/
tools/*.xml
tools/bake/out/
# the bake project's art is a copy of recovery output; keep only its tool script
tools/bake/Assets/*
!tools/bake/Assets/Editor/
tools/bake/Assets/Editor/*.meta
tools/bake/Packages/
tools/bake/ProjectSettings/
tools/bake/[Ll]ibrary/
tools/bake/[Tt]emp/
tools/bake/[Ll]ogs/
tools/bake/[Uu]ser[Ss]ettings/
tools/bake/*.csproj
tools/bake/*.sln

# Unity
game/[Ll]ibrary/
game/[Tt]emp/
game/[Oo]bj/
game/[Bb]uild/
game/[Bb]uilds/
game/[Ll]ogs/
game/[Uu]ser[Ss]ettings/
game/*.csproj
game/*.sln
game/.vs/
*.log

# map bake project: a copy of recovery output; keep only its tool script
tools/mapbake/*
!tools/mapbake/Assets/
tools/mapbake/Assets/*
!tools/mapbake/Assets/Editor/
tools/mapbake/Assets/Editor/*.meta

recovery/audio/
